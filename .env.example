# Copy this file to .env and adjust the values below.
# docker-compose.yml reads .env automatically - no need to edit the compose file itself.

# Host folder (or full path) containing your music/video library. Mounted read-only.
MUSIC_PATH=./music

# Optional additional folders, mixed into the same library as if they were
# all one root directory (same folder names merge together, tracks are
# combined). Leave blank if you only have one folder.
MUSIC_PATH_2=
MUSIC_PATH_3=
MUSIC_PATH_4=

# Port on the host machine to reach justfplay on (container always listens on 3000 internally).
HOST_PORT=3000

# Text shown as the page title / header in the browser.
SITE_TITLE=justfplay

# Optional HTTP Basic Auth. Leave both blank to disable (the default).
# Only meaningful protection if this instance is reached over TLS (e.g.
# behind a reverse proxy that terminates HTTPS) — over plain HTTP the
# credentials travel unencrypted on every request.
AUTH_USER=
AUTH_PASS=
